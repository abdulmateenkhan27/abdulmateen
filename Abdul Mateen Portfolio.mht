@charset "utf-8";

:root { color-scheme: light; --paper: #F8F5EF; --beige: #E8DCC8; --ink: #28231E; --muted: #5E584F; --rule: #A7A29A; --rule-soft: #D9CFBD; --select: #1D4ED8; --display: 'Instrument Serif', 'Iowan Old Style', Georgia, 'Times New Roman', serif; --body: 'Manrope', 'Segoe UI', system-ui, sans-serif; --mono: 'DM Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace; --r: 14px; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--paper); color: var(--ink); font-family: var(--body); font-size: 16px; line-height: 1.6; overflow-x: hidden; }

a { color: inherit; }

a:focus-visible, button:focus-visible { outline: 2px solid var(--select); outline-offset: 3px; }

h1, h2, h3, p { margin: 0px; }

h1, h2, h3 { text-wrap: balance; font-weight: 400; }

p { text-wrap: pretty; }

.wrap { max-width: 1160px; margin: 0px auto; padding-inline: clamp(20px, 4vw, 48px); }

.label { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }

.top { border-bottom: 1px solid var(--rule-soft); }

.top .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 32px; padding-block: 14px; }

.brand { font-family: var(--display); font-size: 30px; line-height: 1; text-decoration: none; min-height: 44px; display: flex; align-items: center; }

.brand i { font-style: italic; }

.links { display: flex; flex-wrap: wrap; gap: 0px 26px; font-size: 14px; font-weight: 500; }

.links a { text-decoration: none; color: var(--muted); padding: 12px 0px; transition: color 0.15s; }

.links a:hover { color: var(--ink); }

.hero .wrap { padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 80px); display: flex; flex-direction: column; gap: 28px; }

.hero-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 24px; }

h1 { font-family: var(--display); font-size: clamp(64px, 15vw, 208px); line-height: 0.92; letter-spacing: -0.02em; min-height: 0.92em; }

.hero-cols { display: flex; flex-wrap: wrap; gap: 40px 72px; align-items: flex-end; padding-top: 28px; border-top: 1px solid var(--ink); }

.hero-left { flex: 3 1 420px; min-width: 0px; display: flex; flex-direction: column; gap: 22px; align-items: flex-start; }

.roles { display: flex; flex-wrap: wrap; gap: 8px; }

.role { padding: 6px 14px; border: 1px solid var(--ink); border-radius: 999px; font-size: 13px; font-weight: 600; }

.lede { max-width: 540px; font-size: 19px; color: var(--muted); }

.btns { display: flex; flex-wrap: wrap; gap: 12px; }

.btn { display: inline-flex; align-items: center; gap: 10px; min-height: 50px; padding: 0px 24px; border: 1px solid var(--ink); border-radius: 999px; background: transparent; color: var(--ink); text-decoration: none; font-family: var(--body); font-size: 15px; font-weight: 600; cursor: pointer; transition: transform 0.15s, background 0.15s, color 0.15s; }

.btn:hover { transform: translateY(-2px); background: var(--beige); }

.btn.primary { background: var(--ink); color: var(--paper); }

.btn.primary:hover { background: rgb(59, 52, 45); }

.photo { flex: 2 1 260px; max-width: 380px; aspect-ratio: 4 / 5; border-radius: var(--r); background: var(--beige); position: relative; overflow: hidden; }

.photo img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: grayscale(1) contrast(1.08); mix-blend-mode: multiply; }

.sec { border-top: 1px solid var(--rule-soft); }

.sec > .wrap { padding-block: clamp(64px, 8vw, 104px); display: flex; flex-direction: column; gap: 44px; }

.head { display: flex; flex-direction: column; gap: 12px; }

.eyebrow { min-height: 1.6em; }

h2 { font-family: var(--display); font-size: clamp(40px, 5.4vw, 68px); line-height: 1.02; letter-spacing: -0.01em; min-height: 1.02em; }

.sub { max-width: 600px; font-size: 18px; color: var(--muted); }

.tint { background: var(--beige); }

.dark { background: var(--ink); color: var(--paper); --muted: #CFC6B6; --rule-soft: #4A433B; border-top: 0px; }

.about { display: flex; flex-wrap: wrap; gap: 44px 72px; }

.about-text { flex: 3 1 440px; min-width: 0px; display: flex; flex-direction: column; gap: 20px; font-size: 18px; max-width: 640px; }

.about-text p:first-child { font-family: var(--display); font-size: clamp(26px, 3vw, 34px); line-height: 1.22; }

.about-text p + p { color: var(--muted); }

.about-side { flex: 2 1 280px; min-width: 0px; display: flex; flex-direction: column; gap: 20px; }

.note { padding: 26px; border-radius: var(--r); background: var(--beige); display: flex; flex-direction: column; gap: 10px; }

.note q { font-family: var(--display); font-style: italic; font-size: 28px; line-height: 1.2; quotes: none; }

.facts { display: flex; flex-direction: column; border-bottom: 1px solid var(--rule-soft); }

.fact { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0px; border-top: 1px solid var(--rule-soft); font-size: 15px; }

.fact b { font-weight: 600; text-align: right; }

.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 20px; }

.card { padding: 28px; border: 1px solid var(--rule-soft); border-radius: var(--r); background: var(--paper); display: flex; flex-direction: column; gap: 12px; transition: transform 0.2s, border-color 0.2s; }

.card:hover { transform: translateY(-4px); border-color: var(--ink); }

.card-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }

.tagchip { padding: 4px 12px; border-radius: 999px; background: var(--ink); color: var(--paper); font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }

.tagchip.line { background: transparent; color: var(--ink); border: 1px solid var(--ink); }

h3 { font-family: var(--display); font-size: 30px; line-height: 1.1; min-height: 1.1em; }

.card p { font-size: 15px; color: var(--muted); }

.card.empty { border-style: dashed; border-color: var(--rule); background: transparent; justify-content: center; }

.dark .card { background: transparent; }

.dark .card:hover { border-color: var(--beige); }

.dark .tagchip { background: var(--beige); color: var(--ink); }

.dark .idx { color: var(--muted); }

.idx { font-family: var(--mono); font-size: 12px; color: var(--muted); }

.duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 20px; }

.panel { padding: clamp(28px, 4vw, 44px); border-radius: var(--r); display: flex; flex-direction: column; gap: 16px; }

.panel.light { background: var(--paper); border: 1px solid var(--rule-soft); }

.panel.ink { background: var(--ink); color: var(--paper); --muted: #CFC6B6; }

.panel h3 { font-size: clamp(32px, 3.6vw, 44px); }

.panel p { color: var(--muted); font-size: 16px; }

.panel .facts { margin-top: 6px; }

.interests { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 16px; }

.interest { padding: 24px; border: 1px solid var(--rule-soft); border-radius: var(--r); display: flex; flex-direction: column; gap: 28px; transition: background 0.2s, border-color 0.2s; }

.interest:hover { background: var(--beige); border-color: var(--beige); }

.interest svg { width: 28px; height: 28px; }

.interest span { font-family: var(--display); font-size: 26px; line-height: 1.1; }

.contact > .wrap { align-items: flex-start; }

.contact h2 { max-width: 820px; font-size: clamp(44px, 6.4vw, 88px); }

.ways { width: 100%; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(440px, 100%), 1fr)); gap: 0px 40px; border-bottom: 1px solid var(--rule-soft); }

.way { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 6px 16px; padding: 18px 0px; border-top: 1px solid var(--rule-soft); min-height: 64px; }

.way a, .way b { font-size: 17px; font-weight: 600; overflow-wrap: anywhere; }

.way em { font-style: normal; color: var(--muted); font-size: 15px; }

footer { border-top: 1px solid var(--rule-soft); }

footer .wrap { padding-block: 36px 110px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 40px; }

.foot-id { display: flex; flex-direction: column; gap: 4px; }

.foot-id strong { font-family: var(--display); font-weight: 400; font-size: 32px; line-height: 1.1; }

.foot-id span, .copy { font-size: 14px; color: var(--muted); }

.foot-links { display: flex; flex-wrap: wrap; gap: 0px 22px; font-size: 14px; font-weight: 500; }

.foot-links a { text-decoration: none; padding: 10px 0px; }

.foot-links a:hover { text-decoration: underline; }

.building .lyr { opacity: 0; }

.building .lyr.on { opacity: 1; transition: opacity 0.3s; }

#stage { position: absolute; top: 0px; left: 0px; width: 0px; height: 0px; pointer-events: none; z-index: 40; }

.cur { position: absolute; top: 0px; left: 0px; width: 22px; height: 22px; will-change: transform; transition: transform 0.4s cubic-bezier(0.3, 0.7, 0.2, 1), opacity 0.5s; filter: drop-shadow(rgba(40, 35, 30, 0.35) 0px 2px 3px); }

.sel { position: absolute; border: 1px solid var(--select); background: rgba(29, 78, 216, 0.06); animation: 0.16s ease-out 0s 1 normal none running selin; }

.sel::before, .sel::after { content: ""; position: absolute; width: 7px; height: 7px; background: rgb(255, 255, 255); border: 1px solid var(--select); }

.sel::before { top: -4px; left: -4px; }

.sel::after { bottom: -4px; right: -4px; }

.sel i { position: absolute; left: 50%; top: 100%; transform: translate(-50%, 6px); padding: 1px 6px; background: var(--select); color: rgb(255, 255, 255); font-variant-ligatures: ; font-variant-caps: ; font-variant-numeric: ; font-variant-east-asian: ; font-variant-alternates: ; font-variant-position: ; font-variant-emoji: ; font-weight: ; font-stretch: ; font-size: ; line-height: ; font-family: ; font-optical-sizing: ; font-size-adjust: ; font-kerning: ; font-feature-settings: ; font-variation-settings: ; font-language-override: ; font-style: normal; white-space: nowrap; }

@keyframes selin { 
  0% { transform: scale(1.04); opacity: 0; }
}

#hud { position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%); z-index: 50; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px 14px; max-width: calc(-24px + 100vw); padding: 8px 10px 8px 16px; background: rgba(40, 35, 30, 0.96); border: 1px solid rgb(90, 81, 72); border-radius: 999px; font-style: ; font-variant-ligatures: ; font-variant-caps: ; font-variant-east-asian: ; font-variant-alternates: ; font-variant-position: ; font-variant-emoji: ; font-weight: ; font-stretch: ; font-size: ; line-height: ; font-family: ; font-optical-sizing: ; font-size-adjust: ; font-kerning: ; font-feature-settings: ; font-variation-settings: ; font-language-override: ; color: rgb(248, 245, 239); box-shadow: rgba(40, 35, 30, 0.3) 0px 10px 30px; font-variant-numeric: tabular-nums; }

#hud .dots { display: flex; }

#hud .dots span { width: 12px; height: 12px; border-radius: 50%; border: 2px solid rgb(40, 35, 30); margin-left: -4px; }

#hud .bar { width: 90px; height: 4px; background: rgb(90, 81, 72); border-radius: 2px; overflow: hidden; }

#hud .bar span { display: block; height: 100%; width: 0px; background: rgb(232, 220, 200); transition: width 0.2s; }

#hud button { min-height: 32px; padding: 0px 12px; border-radius: 999px; border: 1px solid rgb(107, 97, 87); background: rgb(59, 52, 45); color: rgb(248, 245, 239); font: 500 12px/1 var(--mono); cursor: pointer; }

#hud button:hover { background: rgb(74, 67, 59); }

#hud #mode { border-color: rgb(232, 220, 200); background: rgb(232, 220, 200); color: rgb(40, 35, 30); }

#hud[data-state="done"] .live, #hud[data-state="idle"] .live { display: none; }

#hud[data-state="run"] .rest { display: none; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .btn, .card, .interest { transition: none; }
}
